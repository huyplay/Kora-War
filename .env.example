# Copy to .env.local. This file contains placeholders only; never commit credentials.
KORA_POSTGRES_CONNECTION=Host=localhost;Port=5432;Database=kora_war;Username=kora_war;Password=CHANGE_ME
KORA_STORAGE_PROVIDER=local
KORA_OBJECT_ROOT=.data/objects
# Asset API is private to the local backend. Use a random 32+ character shared token.
KORA_ASSET_API_TOKEN=CHANGE_ME_TO_A_RANDOM_32_CHARACTER_TOKEN
KORA_ASSET_API_URL=http://127.0.0.1:8790
# After running assets:sync and verifying the service, opt in to service reads.
KORA_ASSET_READ_SOURCE=local
# Optional future R2 configuration; do not put these values in VITE_* variables.
KORA_R2_ACCOUNT_ID=
KORA_R2_ACCESS_KEY_ID=
KORA_R2_SECRET_ACCESS_KEY=
KORA_R2_BUCKET=
KORA_CDN_BASE_URL=
