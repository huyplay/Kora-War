{
  "name": "kora-war",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node tools/check-architecture.mjs",
    "check": "npm run check:architecture && npm run typecheck:server && npm test && npm run build",
    "smoke": "tsx tools/runtime-smoke.ts",
    "package": "node tools/package-release.mjs",
    "server": "tsx server/index.ts",
    "start": "npm run build && npm run server",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "assets:import": "tsx tools/import-riot-assets.ts",
    "assets:heroes": "tsx tools/import-hero-catalog.ts",
    "assets:presentation": "tsx tools/import-model-presentation.ts",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"server/**/*.ts\" \"tools/*.ts\" \"tests/*.ts\"",
    "assets:media:download": "python tools/download-media.py",
    "assets:media:import": "tsx tools/import-media-assets.ts",
    "assets:reactions": "tsx tools/import-reaction-assets.ts",
    "assets:sync": "tsx tools/sync-asset-service.ts",
    "assets:verify": "tsx tools/verify-asset-service.ts",
    "backend:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-backend.ps1",
    "backend:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-asset-api.ps1",
    "backend:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-backend.ps1"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.180.0",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
